{
  "manifest_version": 3,
  "name": "Motteta",
  "description": "ローカルの書籍台帳で、購入や所持の記録を照合します。",
  "version": "0.1.0",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Motteta"
  },
  "key": ""
}
