{
  "name": "motteta-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schemas": "node generate-types.mjs",
    "adapters": "node generate-adapters.mjs",
    "check": "node generate-types.mjs --check && node generate-adapters.mjs --check && tsc --noEmit",
    "test": "node generate-adapters.mjs --check && vitest run",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.30",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
